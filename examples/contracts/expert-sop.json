  "rules": [
    {
      "id": "confirm-contract",
      "instruction": "每次开始或恢复时读取任务目标、边界、输入基线、技能版本和验收条件；前提不足先报告阻塞。",
      "applies_to": "every_run",
      "condition": null
    },
    {
      "id": "respect-scope",
      "instruction": "只在宿主授权、角色职责和当前任务边界的交集内执行；发现冲突先停止，不临时放宽边界。",
      "applies_to": "every_run",
      "condition": null
    },
    {
      "id": "separate-facts",
      "instruction": "区分已核验事实、假设和待验证信息；不把未确认的目标或硬件行为写成冻结事实。",
      "applies_to": "every_run",
      "condition": null
    },
    {
      "id": "verify-change",
      "instruction": "修改实现后执行与目标相关的正确性和边界检查，保存原始命令、退出码、产物与实际结果。",
      "applies_to": "conditional",
      "condition": "本次任务修改了实现。"
    },
    {
      "id": "report-and-handoff",
      "instruction": "逐项报告验收和 SOP 遵守情况；明确失败、未执行及阻塞，保留检查点和下一步动作。",
      "applies_to": "every_run",
      "condition": null
    }
  ]
}

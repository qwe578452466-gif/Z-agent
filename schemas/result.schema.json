{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-agent.invalid/schemas/0.3/result.schema.json",
  "title": "Z-agent execution attempt result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "task_id": {
      "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
    },
    "run_id": {
      "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "executor": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
        },
        "role_id": {
          "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/role_id"
        }
      },
      "required": [
        "id",
        "role_id"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/artifact"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/evidence"
      },
      "minItems": 0
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "criterion_id",
          "outcome",
          "evidence_ids",
          "reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": [
                    "passed",
                    "failed"
                  ]
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": [
                    "blocked",
                    "not_run"
                  ]
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "properties": {
                "reason": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "missing_input",
              "missing_credential",
              "capability_unavailable",
              "environment_failure",
              "repository_defect",
              "contract_violation",
              "unknown_hardware"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required_action": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "description",
          "required_action",
          "retryable"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "handoff": {
      "type": "object",
      "properties": {
        "resume_hint": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_path": {
          "anyOf": [
            {
              "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/workspace_path"
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "resume_hint",
        "checkpoint_path",
        "pending_actions"
      ],
      "additionalProperties": false
    },
    "sop_checks": {
      "type": "array",
      "items": {
        "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/sop_check"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "attempt",
    "executor",
    "status",
    "summary",
    "started_at",
    "finished_at",
    "artifacts",
    "evidence",
    "acceptance",
    "blockers",
    "handoff",
    "sop_checks"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blockers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "blocked",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "sop_checks": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/sop_check"
                },
                {
                  "properties": {
                    "outcome": {
                      "enum": [
                        "followed",
                        "not_applicable"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}

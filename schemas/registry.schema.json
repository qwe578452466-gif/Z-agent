{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-agent.invalid/schemas/0.4/registry.schema.json",
  "title": "Z-agent skill planning registry",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.4"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/skill_id"
          },
          "phase": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "documentation",
              "workflow",
              "domain"
            ]
          },
          "owner_role": {
            "anyOf": [
              {
                "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/role_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "allowed_roles": {
            "type": "array",
            "items": {
              "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/role_id"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "draft",
              "experimental",
              "validated",
              "retired"
            ]
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^skills/Z-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "anyOf": [
              {
                "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/version"
              },
              {
                "type": "null"
              }
            ]
          },
          "usage_mode": {
            "type": "string",
            "enum": [
              "standalone",
              "agent_workflow"
            ]
          }
        },
        "required": [
          "id",
          "phase",
          "kind",
          "owner_role",
          "allowed_roles",
          "status",
          "path",
          "version",
          "usage_mode"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "planned"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "path": {
                  "type": "null"
                },
                "version": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^skills/Z-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                },
                "version": {
                  "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/version"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "usage_mode": {
                  "const": "standalone"
                }
              },
              "required": [
                "usage_mode"
              ]
            },
            "then": {
              "properties": {
                "owner_role": {
                  "type": "null"
                },
                "allowed_roles": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "owner_role": {
                  "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/role_id"
                },
                "allowed_roles": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 24,
      "maxItems": 24
    }
  },
  "required": [
    "schema_version",
    "skills"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "properties": {
        "skills": {
          "contains": {
            "properties": {
              "phase": {
                "const": "P0"
              }
            },
            "required": [
              "phase"
            ]
          },
          "minContains": 12,
          "maxContains": 12
        }
      }
    },
    {
      "properties": {
        "skills": {
          "contains": {
            "properties": {
              "phase": {
                "const": "P1"
              }
            },
            "required": [
              "phase"
            ]
          },
          "minContains": 8,
          "maxContains": 8
        }
      }
    },
    {
      "properties": {
        "skills": {
          "contains": {
            "properties": {
              "phase": {
                "const": "P2"
              }
            },
            "required": [
              "phase"
            ]
          },
          "minContains": 4,
          "maxContains": 4
        }
      }
    }
  ]
}

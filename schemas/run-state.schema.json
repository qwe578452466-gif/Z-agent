{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-agent.invalid/schemas/0.3/run-state.schema.json",
  "title": "Z-agent run state snapshot",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "run_id": {
      "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_event_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "baseline": {
      "type": "object",
      "properties": {
        "repository_path": {
          "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/workspace_path"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "design_document": {
          "anyOf": [
            {
              "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_document": {
          "anyOf": [
            {
              "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repository_path",
        "revision",
        "design_document",
        "execution_document"
      ],
      "additionalProperties": false
    },
    "events_path": {
      "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/workspace_path"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
          },
          "spec_path": {
            "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/workspace_path"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "ready",
              "running",
              "awaiting_review",
              "blocked",
              "failed",
              "accepted",
              "cancelled"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "executor_id": {
            "anyOf": [
              {
                "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_result_path": {
            "anyOf": [
              {
                "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/workspace_path"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_checkpoint_path": {
            "anyOf": [
              {
                "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/workspace_path"
              },
              {
                "type": "null"
              }
            ]
          },
          "review": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "reviewer_id": {
                    "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
                  },
                  "reviewer_role": {
                    "const": "independent-reviewer"
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approved",
                      "changes_requested",
                      "inconclusive"
                    ]
                  },
                  "report": {
                    "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/artifact"
                  },
                  "reviewed_artifacts": {
                    "type": "array",
                    "items": {
                      "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/artifact"
                    },
                    "minItems": 1
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
                    },
                    "minItems": 0,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "reviewer_id",
                  "reviewer_role",
                  "decision",
                  "report",
                  "reviewed_artifacts",
                  "evidence_ids"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "decision": {
                          "const": "approved"
                        }
                      },
                      "required": [
                        "decision"
                      ]
                    },
                    "then": {
                      "properties": {
                        "reviewed_artifacts": {
                          "items": {
                            "allOf": [
                              {
                                "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/artifact"
                              },
                              {
                                "properties": {
                                  "sha256": {
                                    "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/sha256"
                                  }
                                }
                              }
                            ]
                          }
                        },
                        "report": {
                          "allOf": [
                            {
                              "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/artifact"
                            },
                            {
                              "properties": {
                                "sha256": {
                                  "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/sha256"
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "task_id",
          "spec_path",
          "status",
          "depends_on",
          "attempt",
          "executor_id",
          "last_result_path",
          "last_checkpoint_path",
          "review",
          "last_error"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "running"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "attempt": {
                  "minimum": 1
                },
                "executor_id": {
                  "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "awaiting_review",
                    "accepted"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "attempt": {
                  "minimum": 1
                },
                "executor_id": {
                  "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
                },
                "last_result_path": {
                  "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/workspace_path"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "accepted"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "review": {
                  "allOf": [
                    {
                      "type": "object",
                      "properties": {
                        "reviewer_id": {
                          "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
                        },
                        "reviewer_role": {
                          "const": "independent-reviewer"
                        },
                        "decision": {
                          "type": "string",
                          "enum": [
                            "approved",
                            "changes_requested",
                            "inconclusive"
                          ]
                        },
                        "report": {
                          "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/artifact"
                        },
                        "reviewed_artifacts": {
                          "type": "array",
                          "items": {
                            "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/artifact"
                          },
                          "minItems": 1
                        },
                        "evidence_ids": {
                          "type": "array",
                          "items": {
                            "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
                          },
                          "minItems": 0,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "reviewer_id",
                        "reviewer_role",
                        "decision",
                        "report",
                        "reviewed_artifacts",
                        "evidence_ids"
                      ],
                      "additionalProperties": false,
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "decision": {
                                "const": "approved"
                              }
                            },
                            "required": [
                              "decision"
                            ]
                          },
                          "then": {
                            "properties": {
                              "reviewed_artifacts": {
                                "items": {
                                  "allOf": [
                                    {
                                      "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/artifact"
                                    },
                                    {
                                      "properties": {
                                        "sha256": {
                                          "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/sha256"
                                        }
                                      }
                                    }
                                  ]
                                }
                              },
                              "report": {
                                "allOf": [
                                  {
                                    "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/artifact"
                                  },
                                  {
                                    "properties": {
                                      "sha256": {
                                        "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/sha256"
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "properties": {
                        "decision": {
                          "const": "approved"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "enum": [
              "approved_requirement",
              "verified_evidence",
              "hypothesis"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "source_artifact_id": {
            "anyOf": [
              {
                "$ref": "https://z-agent.invalid/schemas/0.3/common.schema.json#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "statement",
          "basis",
          "evidence_ids",
          "source_artifact_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "updated_at",
    "last_event_sequence",
    "baseline",
    "events_path",
    "tasks",
    "decisions"
  ],
  "additionalProperties": false
}
